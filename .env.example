# Public project credentials are safe to expose to browser clients.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
NEXT_PUBLIC_SHARED_ACCOUNT_USERNAME=your-shared-id
NEXT_PUBLIC_SHARED_ACCOUNT_EMAIL=your-shared-account@example.com

# Server-side only; used by the one-time mock-data seed script.
# Never prefix this value with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
